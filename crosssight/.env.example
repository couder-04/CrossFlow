# ANPR Platform environment (copy to .env)

# Set APP_ENV=prod in production; JWT_SECRET, POSTGRES_PASSWORD, MINIO_SECRET_KEY must be changed from defaults or boot will fail.
APP_ENV=dev

# City / simulation
CITY_QUERY=Pune, India
# CITY_BBOX=73.75,18.45,73.95,18.65
NUM_CAMERAS=60
NUM_VEHICLES=3000
MAX_URBAN_SPEED_KMH=120
TRIP_GAP_MIN=30
OD_K_ANON=5
RAW_RETENTION_DAYS=30
H3_HEATMAP_RES=8
H3_OD_RES=7
SIM_SPEED=60
# Synthetic camera-wall JPEGs when no RTSP source is attached
SIM_PUBLISH_FRAMES=true

# Kafka / Redpanda
KAFKA_BOOTSTRAP=localhost:19092
TOPIC_READS=anpr.reads.v1
TOPIC_ALERTS=alerts.v1
TOPIC_FLOW=analytics.flow.v1

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=anpr

# Postgres / PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=anpr
POSTGRES_PASSWORD=anpr
POSTGRES_DB=anpr

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
# MinIO address browsers use for presigned image URLs (camera wall, crops). Docker: the host
# users reach MinIO on; empty = MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anpr-crops
MINIO_SECURE=false

# Auth (demo only — rotate in production)
# REQUIRED in production: long random JWT_SECRET; never commit real secrets.
# The dashboard middleware verifies this same HS256 secret. Give the Next.js
# process the identical JWT_SECRET the API uses, or every page redirects to /login.
JWT_SECRET=change-me-demo-jwt-secret-anpr-platform
JWT_EXPIRE_MINUTES=480
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=admin123
SEED_OPERATOR_USER=operator
SEED_OPERATOR_PASS=operator123
SEED_ANALYST_USER=analyst
SEED_ANALYST_PASS=analyst123

# Workers / scale
# Local demo: make workers
# City-scale compose: ALERTS_REPLICAS=3 make prod-up
# HEALTH_PORT=8083
# ALERTS_GROUP_ID=anpr-alerts
ALERTS_REPLICAS=3
# Background export/upload rows left in processing longer than this are marked failed on API boot.
STALE_JOB_MINUTES=30
# Cap for streamed media uploads. Reject with 413 once the body exceeds this.
MAX_UPLOAD_BYTES=536870912

# API / Dashboard
# If port 8000 is taken by another app, use 8002 (project default in .env).
API_HOST=0.0.0.0
API_PORT=8002
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_WS_URL=ws://localhost:8002/ws/live
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# Set to true to let the live map step back up to 15 minutes (heatmap and segments refetch with at=).
NEXT_PUBLIC_ENABLE_TIME_SCRUB=false
CORS_ORIGINS=http://localhost:3000

# OCR (weights never committed)
# Default backend: plateocr (FastALPR YOLOv9 + India CCT fine-tune)
OCR_BACKEND=plateocr
PLATEOCR_DETECTOR=yolo-v9-s-608-license-plate-end2end
# india-v1.1: fine-tuned Indian OCR (~5 MB, auto-download from PlateOCR releases).
# Same predictions as india-v1, ~2x faster on CPU. india-v1 still works for pinned setups.
# Use cct-s-v2-global-model for non-Indian / multi-region plates
PLATEOCR_OCR_MODEL=india-v1.1
PLATEOCR_PLATE_FORMAT=india
PLATEOCR_DEVICE=auto
PLATEOCR_DET_CONF=0.4
# Drop per-frame reads below this mean char confidence (garbage ~0.05-0.2, clear plates 0.9+).
PLATEOCR_MIN_OCR_CONF=0.5
# Accuracy extras, OFF for live video: TTA ~7x OCR cost for ~+1 pt; bbox pad ~4x.
PLATEOCR_TTA=0
PLATEOCR_BBOX_PAD=0
# Process every Nth frame (2-3 on CPU-only hosts).
OCR_FRAME_STRIDE=1
# Reads below this fused confidence never raise watchlist alerts.
WATCHLIST_MIN_CONF=0.5
# Optional: PLATEOCR_OCR_CONFIG=/path/to/custom_plate_config.yaml
# Offline mirror: PLATE_OCR_CACHE=~/.cache/plate-ocr  PLATE_OCR_MODEL_URL=https://…
# Legacy backend (OCR_BACKEND=legacy) needs local YOLO plate detector + optional PARSeq:
PLATE_DET_WEIGHTS=
PARSEEQ_WEIGHTS=
OCR_CAMERA_ID=cam-demo
# Publish latest annotated JPEG + Redis `frames` notices for the camera wall
PUBLISH_ANNOTATED_FRAMES=true

# Optional local vehicle registry JSON (enables plate↔vehicle mismatch alerts without Vahan)
# REGISTRY_PATH=services/workers/data/registry_demo.json
ROUTE_ANOMALY_MIN_CAMERAS=3
ROUTE_ANOMALY_DISTANCE_M=8000
